{
  "description": "Checks due follow-ups and queued automatic replies every five minutes, with contact-safety checks and pagination inside the worker.",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "sequence_sender",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "send_due": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sequenceSender",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Process due messages",
            "description": "Consent, local hours and mode checks"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/5 * * * *",
      "one_time_date": null,
      "timezone": "America/Chicago",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "name": "Sequence Sender"
}