{
  "name": "Subscription Sync",
  "description": "Daily: refreshes every agent subscription status from Stripe so lapsed subscriptions stop texting.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "15 5 * * *",
      "one_time_date": null,
      "timezone": "America/Chicago",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "do": [
      {
        "sync": {
          "call": "invoke_backend_function",
          "then": "end",
          "with": {
            "args": {
              "action": "sync"
            },
            "function_name": "adminSubscriptions"
          },
          "x-base44": {
            "description": "Refresh subscription status from Stripe",
            "title": "Sync subscriptions"
          }
        }
      }
    ],
    "document": {
      "dsl": "1.0.0",
      "name": "subscription_sync",
      "namespace": "base44",
      "version": "1.0"
    }
  }
}