      "type": "string"
    },
    "campaign_id": {
      "type": "string"
    },
    "error": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "profile": {
      "type": "object"
    },
    "prompt_version": {
      "type": "number"
    },
    "results": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "source": {
      "description": "sample:<name> or lead",
      "type": "string"
    }
  },
  "required": [
