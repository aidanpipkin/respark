{
  "description": "Server-only store for the agency's GHL OAuth tokens. No user can read or write it; only backend functions using the service role.",
  "name": "PlatformCredential",
  "properties": {
    "access_token": {
      "type": "string"
    },
    "company_id": {
      "type": "string"
    },
    "connected_at": {
      "type": "string"
    },
    "expires_at": {
      "type": "string"
    },
    "installed_by_user_id": {
      "type": "string"
    },
    "is_bulk_installation": {
      "type": "boolean"
    },
    "key": {
      "description": "ghl_agency",
      "type": "string"
    },
    "last_error": {
      "type": "string"
    },
    "last_refresh_at": {
      "type": "string"
    },
    "refresh_token": {
      "type": "string"
    },
    "scope": {
      "type": "string"
    }
  },
  "required": [
    "key"
  ],
  "rls": {
    "create": false,
    "delete": false,
    "read": false,
    "update": false
  },
  "type": "object"
}