{
  "name": "Riley Respark Enroller",
  "description": "Every 5 minutes: enrolls New Lead trucker opportunities from Riley's two Respark pipelines (no reply, not DND) into Riley's 30-day Respark text sequence (RileyResparkLead). Riley Fresh Premium Truckers has no age gate so hand-dropped leads start texting within minutes (inside 9am-7:30pm local).",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "1-56/5 * * * *",
      "one_time_date": null,
      "timezone": "America/Chicago",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "riley_respark_enroller",
      "version": "1.1",
      "namespace": "base44"
    },
    "do": [
      {
        "enroll": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "rileyEnroll",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Enroll Riley's new leads",
            "description": "rileyEnroll"
          }
        }
      }
    ]
  }
}